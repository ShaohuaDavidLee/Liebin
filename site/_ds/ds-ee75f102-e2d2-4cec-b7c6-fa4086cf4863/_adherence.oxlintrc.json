{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/core/**",
              "components/editorial/**",
              "components/media/**",
              "ui_kits/homepage/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Noto Serif SC|EB Garamond))/i]",
        "message": "Font not provided by the design system. Available: Inter, Noto Serif SC, EB Garamond."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|dot|children|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, dot, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|live)$/]",
        "message": "<Badge> variant must be one of 'gold' | 'live'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|arrow|icon|children|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, arrow, icon, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dark|crimson|ghost)$/]",
        "message": "<Button> variant must be one of 'dark' | 'crimson' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|href|className|key|ref|className|style|children)$/]",
        "message": "<ContactTile> doesn't accept that prop. Declared props: icon, label, value, href, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialList'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|more|className|key|ref|className|style|children)$/]",
        "message": "<EditorialList> doesn't accept that prop. Declared props: children, more, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|iconColor|eyebrow|title|en|names|note|className|key|ref|className|style|children)$/]",
        "message": "<FeatureRow> doesn't accept that prop. Declared props: icon, iconColor, eyebrow, title, en, names, note, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='GoldRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|center|className|style|key|ref|className|style|children)$/]",
        "message": "<GoldRule> doesn't accept that prop. Declared props: width, center, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndexRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|name|domain|desc|href|icon|className|key|ref|className|style|children)$/]",
        "message": "<IndexRow> doesn't accept that prop. Declared props: numeral, name, domain, desc, href, icon, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='LatinAside'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<LatinAside> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|roman|title|desc|className|key|ref|className|style|children)$/]",
        "message": "<NumberedRow> doesn't accept that prop. Declared props: n, roman, title, desc, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|hint|ratio|objectPosition|scrim|className|style|key|ref|className|style|children)$/]",
        "message": "<PhotoFrame> doesn't accept that prop. Declared props: src, alt, caption, hint, ratio, objectPosition, scrim, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RoleChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<RoleChip> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|aside|rule|center|className|key|ref|className|style|children)$/]",
        "message": "<SectionHead> doesn't accept that prop. Declared props: kicker, title, aside, rule, center, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StripeFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|caption|ratio|minHeight|className|style|key|ref|className|style|children)$/]",
        "message": "<StripeFrame> doesn't accept that prop. Declared props: label, caption, ratio, minHeight, className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
